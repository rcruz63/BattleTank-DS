// Configuración de despliegue en Cloudflare Workers (assets estáticos).
// El juego es 100 % cliente: no hay Worker con lógica, solo `dist/` servido como assets.
// El nombre debe coincidir con el del proyecto creado en el dashboard (Workers Builds).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "battletank-ds",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
  },
}
